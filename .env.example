# Google Gemini API Key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# EmailJS Configuration
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
NEXT_PUBLIC_EMAILJS_DOCTOR_TEMPLATE_ID=your_emailjs_doctor_template_id_here

# Doctor Email Configuration
DOCTOR_EMAIL=your_doctor_email@example.com

# Email Service Configuration (for future use with real email service)
EMAIL_FROM=noreply@docbook.com
EMAIL_FROM_NAME=DocBook
EMAIL_PROVIDER=mock

# Google Sheets API Configuration
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_PRIVATE_KEY=your_private_key_here
GOOGLE_CLIENT_EMAIL=your_client_email@your_project_id.iam.gserviceaccount.com
GOOGLE_CLIENT_ID=your_client_id

# Google Sheets Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_SHEET_NAME=Bookings